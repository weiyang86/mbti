# 复制为本机 .env.development.local（勿提交实际环境文件）

# API 根路径，需包含 /api/v1；联调契约见 docs/api-reference/
VITE_API_BASE_URL=https://mbti-dev.bestshizhongyu.com/api/v1

# true 时使用 src/api/mock，无需后端即可演示带教闭环
VITE_USE_MOCK=false

# 非 Mock 时自动 POST /auth/guest；浏览器本地持有凭证，刷新复用。
# 不配置共享游客 token。H5 与 API 在同一域名时也可用 /api/v1。
# 本地 H5 跨源调用时，后端仍需明确允许该本地 Origin。
