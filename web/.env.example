# 复制为本机 .env.development.local（勿提交实际环境文件）

# API 根路径，需包含 /api/v1（与 docs/api/openapi-v0.1-draft.yaml 一致）
VITE_API_BASE_URL=http://192.168.0.200:4056/api/v1

# true 时使用 src/api/mock，无需后端即可演示带教闭环
VITE_USE_MOCK=false

# 非 Mock 时自动 POST /auth/guest；浏览器本地持有凭证，刷新复用。
# 不配置共享游客 token。换开发机时同时更新 API IP 和后端允许的 H5 源。
