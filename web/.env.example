# 复制为 .env.development 或 .env 后使用（勿提交真实密钥）

# API 根路径，需包含 /api/v1。公网 P0 stub 见 docs/api/联调教程.md
VITE_API_BASE_URL=https://mbti-dev.bestshizhongyu.com/api/v1

# true 时使用 src/api/mock，无需后端即可演示带教闭环
VITE_USE_MOCK=true

# 切真实联调：把 VITE_USE_MOCK 改为 false，并使用游客 token
# VITE_GUEST_TOKEN=guest_dev_001

# 本地后端联调（可选，覆盖上面的 Base URL）
# VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
