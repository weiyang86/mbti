# MBTI in-repository foundation: independent project identity.
# Copy this reviewed example to ignored .env; never reuse upstream credentials/data.
# Upstream db:*, base:dev and ai:local tools are not MBTI provisioning commands.
# Database URLs below are disabled placeholders, not provisioned instances.
NODE_ENV=development
RUNTIME_PROFILE=project
PROJECT_ID=mbti-foundation
APP_ENV=development
COMPOSE_PROJECT_NAME=mbti-foundation-dev

WEB_PORT=4055
API_PORT=4056
WEB_URL=http://localhost:4055
NEXT_PUBLIC_API_URL=http://localhost:4056/api
TRUST_PROXY_HOPS=0

POSTGRES_PORT=55436
POSTGRES_USER=mbti_foundation_development
POSTGRES_DB=mbti_foundation_development
# Reserved for future MBTI database provisioning; create independent credentials.
POSTGRES_PASSWORD=
# Replace REPLACE_LOCAL_ONLY and URL-encode special password characters.
# Do not run the upstream host db:up/db:check workflow for this project.
DATABASE_URL=postgresql://mbti_foundation_development:REPLACE_LOCAL_ONLY@127.0.0.1:55436/mbti_foundation_development?schema=public

# Future tests must use their own instance/database/volume, never DATABASE_URL.
TEST_POSTGRES_PORT=55437
TEST_POSTGRES_USER=mbti_foundation_test
TEST_POSTGRES_DB=mbti_foundation_test
TEST_POSTGRES_PASSWORD=
# Runtime APP_ENV=test must read only the independently scoped TEST_DATABASE_URL.
TEST_DATABASE_URL=postgresql://mbti_foundation_test:REPLACE_TEST_ONLY@127.0.0.1:55437/mbti_foundation_test?schema=public

# AF-013: AUTH_ENABLED=true requires a dedicated 32+ character non-template JWT_SECRET.
# AF-025-A: CLIENT_AUTH_ENABLED=true requires independent CLIENT_JWT_SECRET and
# CLIENT_AUTH_RATE_LIMIT_SECRET (32+ characters); no development fallback.
# Explicitly supplied reserved secrets must be strong and distinct from JWT_SECRET.
JWT_SECRET=
CLIENT_JWT_SECRET=
CLIENT_AUTH_RATE_LIMIT_SECRET=
CLIENT_AUTH_TOKEN_SECRET=
# Reserved input for a future MBTI-scoped Seed workflow; no default, never printed.
# Only used on first creation; existing passwords/roles are never reconciled by Seed.
AIJ_INITIAL_ADMIN_PASSWORD=

# Client issuer is JWT_ISSUER + :client; audience is urn:aij:<projectId>:<APP_ENV>:client.
# Client Cookie is COOKIE_PREFIX + _client_session; file services remain unavailable.
JWT_ISSUER=urn:aij:mbti-foundation:development:api
COOKIE_PREFIX=mbti_foundation_development
LOCAL_STORAGE_ROOT=.local-data/mbti-foundation/development/storage
# AF-011: database is opt-in and /api/ready checks real identity + applied migrations.
# Project API reads this project configuration; no upstream host database fallback.
# Empty/template credentials fail validation when the database capability is enabled.
# Do not use upstream DATABASE_ACCEPTANCE_ID records for this project.
# AF-013: auth is opt-in and requires DATABASE_ENABLED=true plus applied migrations.
# Storage remains unavailable; disabled plugins need no credentials.
AUTH_ENABLED=false
CLIENT_AUTH_ENABLED=false
DATABASE_ENABLED=false
STORAGE_ENABLED=false
# AF-049: the persisted worker is opt-in and requires both administrator auth and PostgreSQL.
ASYNC_RUNTIME_ENABLED=false

# New composition must respect this empty list; source hardcoded defaults must go.
ENABLED_PLUGINS=
CLIENT_AUTH_NOTIFICATION_ADAPTER=disabled

# AF-023: optional, server-only. Keep unset when local:// references are unused.
# AIJ_SECRET_STORE_FILE=/absolute/repository/.local-data/secrets/<projectId>/<environment>/store.json
# AIJ_SECRET_STORE_KEY=<64 lowercase hexadecimal characters provisioned securely on this machine>
# env:// references use only AIJ_SECRET_<PROJECT_ID_UPPER>_<ENVIRONMENT_UPPER>_<NAME>.
# Never put values or decryption keys in NEXT_PUBLIC_* or the management API.

# DeepSeek remains disabled until prior upstream data-processing confirmation.
AI_DEEPSEEK_LIVE_ENABLED=false
AI_DEEPSEEK_UPSTREAM_CONFIRMED=false
AI_DEEPSEEK_DATA_CLASS=synthetic-or-deidentified
# Supply a complete frozen evaluation policy locally. Empty configuration denies calls.
AI_EVALUATION_BUDGET_JSON=

# General AI center: defaults never make paid provider requests.
AI_CENTER_LIVE_ENABLED=false
# Direct client route bypasses no business entitlement checks: enable only for workspace-budget-only free/trial use.
# Paid projects should leave false and call exported AiCenterRunService after their own order/entitlement checks.
AI_CENTER_CLIENT_EXECUTION_ENABLED=false
# Exact HTTPS base URLs of trusted OpenAI-compatible providers/proxies (JSON array).
# OpenAI / DeepSeek official bases are built in; DeepSeek retains its separate confirmation gates.
AI_CENTER_ALLOWED_BASE_URLS=[]

# Private document renderer: administrator supplies a pinned local image and absolute Docker CLI.
AIJ_DOCUMENT_EXPORT_ENABLED=false
AIJ_DOCUMENT_EXPORT_IMAGE_ID=
AIJ_DOCUMENT_EXPORT_DOCKER_CLI=
