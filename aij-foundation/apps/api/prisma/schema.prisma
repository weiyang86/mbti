  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([workspaceId, createdAt], map: "audit_log_workspace_created_idx")
  @@map("audit_log")
}

// AF-009: file metadata and plugin state only; provenance section 9.
// Paths/URLs have no environment defaults; validation belongs to the future storage service.
model FileAsset {
