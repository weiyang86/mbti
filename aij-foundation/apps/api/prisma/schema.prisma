  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  @@index([publicationId,runId],map:"workflow_run_origin_publication_idx")
  @@index([projectId,workspaceId,memberId,runId],map:"workflow_run_origin_owner_idx")
  @@map("ai_personal_workflow_run_origin")
}

model AiPersonalScriptVersion {
  runs AiPersonalScriptRun[]
  id String @id @db.Uuid
  projectId String @map("project_id")
  workspaceId String @map("workspace_id")
  memberId String @map("member_id")
  skillId String @map("skill_id")
  skillVersionId String @unique(map: "ai_personal_script_version_original_key") @map("skill_version_id")
  revision Int
  scriptSource String @map("script_source")
  scriptDigest String @map("script_digest")
  policyDigest String @map("policy_digest")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  project ProjectProfile @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ai_personal_script_version_project_fkey")
  skillVersion AiPersonalSkillVersion @relation(fields: [skillVersionId, skillId, workspaceId, memberId, revision], references: [id, skillId, workspaceId, memberId, revision], onDelete: Restrict, onUpdate: Restrict, map: "ai_personal_script_version_original_fkey")
  @@unique([skillVersionId, skillId, workspaceId, memberId, revision], map: "ai_personal_script_version_original_scope_key")
  @@unique([id, projectId, workspaceId, memberId], map: "ai_personal_script_version_scope_key")
  @@map("ai_personal_script_version")
}

model AiPersonalScriptRun {
  id String @id @db.Uuid
  projectId String @map("project_id")
  workspaceId String @map("workspace_id")
  memberId String @map("member_id")
  scriptVersionId String @map("script_version_id") @db.Uuid
  skillRef Json @map("skill_ref")
  requestKey String @map("request_key")
  requestHash String @map("request_hash")
  input Json? @db.Json
  sessionId String @map("session_id")
  tokenVersion Int @map("token_version")
  jobId String @unique(map: "ai_personal_script_run_job_id_key") @map("job_id")
  attemptedAt DateTime? @map("attempted_at") @db.Timestamp(3)
  outcome String?
  outputAssetId String? @map("output_asset_id")
  createdAt DateTime @map("created_at") @db.Timestamp(3)
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)
  contentPurgedAt DateTime? @map("content_purged_at") @db.Timestamp(3)
  scriptVersion AiPersonalScriptVersion @relation(fields: [scriptVersionId, projectId, workspaceId, memberId], references: [id, projectId, workspaceId, memberId], onDelete: Restrict, onUpdate: Restrict, map: "ai_personal_script_run_source_fkey")
  job RuntimeJob @relation(fields: [jobId, projectId, workspaceId], references: [id, scopeId, workspaceId], onDelete: Restrict, onUpdate: Restrict, map: "ai_personal_script_run_job_fkey")
  session ClientAuthSession @relation(fields: [sessionId, memberId], references: [id, memberId], onDelete: Restrict, onUpdate: Restrict, map: "ai_personal_script_run_session_fkey")
  outputAsset FileAsset? @relation(fields: [outputAssetId, projectId, workspaceId, memberId], references: [id, projectId, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "ai_personal_script_run_asset_fkey")
  @@unique([jobId, projectId, workspaceId], map: "ai_personal_script_run_job_scope_key")
  @@unique([projectId, workspaceId, memberId, requestKey], map: "ai_personal_script_run_request_key")
  @@map("ai_personal_script_run")
}

// File-owner tombstones prevent a late commit while failed stage cleanup performs unlocked IO.
model GeneratedFileCleanupFence {
  assetId String @id @map("asset_id")
  objectKey String @unique @map("object_key")
  reservedAt DateTime @default(now()) @map("reserved_at") @db.Timestamp(3)
  removedAt DateTime? @map("removed_at") @db.Timestamp(3)
  @@map("generated_file_cleanup_fence")
}

// Immutable metadata relation only; compound owner FKs/guards live in the additive migration.
model AiPersonalDocumentRunOrigin {
  runId String @id @map("run_id")
  projectId String @map("project_id")
  workspaceId String @map("workspace_id")
  memberId String @map("member_id")
  documentId String @db.Uuid @map("document_id")
  documentRevision Int @map("document_revision")
  agentId String @map("agent_id")
  agentVersionId String @map("agent_version_id")
  agentRevision Int @map("agent_revision")
  ref Json
  sessionId String @map("session_id")
  tokenVersion Int @map("token_version")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  @@index([projectId,workspaceId,memberId,runId],map:"document_run_origin_owner_idx")
  @@index([documentId,documentRevision,runId],map:"document_run_origin_document_idx")
  @@map("ai_personal_document_run_origin")
}

// MBTI business identities are independent guests; opaque credentials are stored only as digests.
model MbtiGuest {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  sessions  MbtiQuizSession[]
  results   MbtiResult[]
}

model MbtiQuestionBank {
  version   String @id
  payload   Json
  scoring   Json
  createdAt DateTime @default(now())
  sessions  MbtiQuizSession[]
}

model MbtiQuizSession {
  id          String @id @default(uuid())
  ownerId     String
  bankVersion String
  status      String @default("in_progress")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       MbtiGuest @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank        MbtiQuestionBank @relation(fields: [bankVersion], references: [version], onDelete: NoAction, onUpdate: NoAction)
  answers     MbtiAnswer[]
  result      MbtiResult?
  @@index([ownerId, createdAt, id])
}

model MbtiAnswer {
  sessionId  String
  questionId String
  optionId   String
  session    MbtiQuizSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([sessionId, questionId])
}

model MbtiResult {
  id              String @id @default(uuid())
  ownerId         String
  sessionId       String? @unique
  source          String
  typeCode        String
  bankVersion     String
  dimensionCounts Json?
  lifeStage       String?
  recentStatus    String?
  submittedAt     DateTime @default(now())
  owner           MbtiGuest @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session         MbtiQuizSession? @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shareAssets     MbtiShareAsset[]
  @@index([ownerId, submittedAt(sort: Desc), id(sort: Desc)])
}

// Only explicitly rendered share images are accessible through the anonymous asset route.
model MbtiShareAsset {
  key       String @id
  resultId  String
  bytes     Bytes
  createdAt DateTime @default(now())
  result    MbtiResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([resultId])
}
