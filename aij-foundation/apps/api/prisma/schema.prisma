  uninstalled
  installed
  enabled
  failed
}

enum PluginOperationStatus {
  pending
  running
  succeeded
  failed
}

enum RuntimeOutboxStatus {
  pending
  processing
  retry
  processed
  dead
}

enum RuntimeJobStatus {
  pending
  running
  retry
  completed
  failed
  dead
  cancelled
}

enum RuntimeIdempotencyStatus {
  processing
  completed
}

enum AiExecutionTraceStatus {
