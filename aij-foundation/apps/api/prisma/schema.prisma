// G17-01: Integration owns connector configuration separately from PluginInstallation.
// Only the reference is persisted; external credentials remain in SecretCenter.
model ConnectorInstallation {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  connectorCode  String    @map("connector_code")
  manifestVersion String   @map("manifest_version")
  scopes         String[]  @default([])
  secretRef      String    @map("secret_ref")
  status         String    @default("configured")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project        ProjectProfile @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  secretReference SecretReference @relation(fields: [secretRef], references: [ref], onDelete: Restrict, onUpdate: Cascade)
  inboundEvents  ConnectorInboundEvent[]
  operations     ConnectorOperation[]

  @@unique([projectId, connectorCode], map: "connector_installation_project_connector_key")
  @@index([projectId, status], map: "connector_installation_project_status_idx")
  @@index([connectorCode, status], map: "connector_installation_connector_status_idx")
