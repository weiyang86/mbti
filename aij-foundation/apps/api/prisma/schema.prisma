  operation ConnectorOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([operationId, attempt], map: "connector_operation_attempt_number_key")
  @@index([operationId, attempt], map: "connector_operation_attempt_history_idx")
