  installationVersion Int      @map("installation_version")
  receivedAt          DateTime @default(now()) @map("received_at")
  createdAt           DateTime @default(now()) @map("created_at")

  connectorInstallation ConnectorInstallation @relation(fields: [projectId, connectorCode], references: [projectId, connectorCode], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, connectorCode, idempotencyKey], map: "connector_inbound_event_idempotency_key")
  @@index([projectId, connectorCode, receivedAt], map: "connector_inbound_event_received_idx")
  @@map("connector_inbound_event")
}

enum ConnectorOperationType {
  secret_reference_check
}

enum ConnectorOperationStatus {
  succeeded
  failed
}

enum ConnectorOperationFailureCode {
  secret_unavailable
}

// G17-03: auditable local connector readiness checks; retries re-read SecretRef metadata only.
// No webhook body, raw secret, provider result or external request is stored.
model ConnectorOperation {
  id                     String                      @id @default(cuid())
  projectId              String                      @map("project_id")
  connectorCode          String                      @map("connector_code")
  type                   ConnectorOperationType
  status                 ConnectorOperationStatus
  attemptCount           Int                         @default(1) @map("attempt_count")
  lastFailureCode        ConnectorOperationFailureCode? @map("last_failure_code")
  installationVersion    Int                         @map("installation_version")
  startedAt              DateTime                    @map("started_at")
  completedAt            DateTime                    @map("completed_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")

  installation ConnectorInstallation        @relation(fields: [projectId, connectorCode], references: [projectId, connectorCode], onDelete: Restrict, onUpdate: Cascade)
  attempts     ConnectorOperationAttempt[]

  @@index([projectId, connectorCode, createdAt, id], map: "connector_operation_project_created_idx")
  @@index([status, updatedAt], map: "connector_operation_status_updated_idx")
  @@map("connector_operation")
}

model ConnectorOperationAttempt {
  id          String                     @id @default(cuid())
  operationId String                     @map("operation_id")
