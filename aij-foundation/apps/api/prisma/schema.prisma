  @@index([projectId, pluginCode])
  @@index([workspaceId, pluginCode], map: "file_asset_workspace_plugin_idx")
  @@index([ownerType, ownerId])
  @@index([status])
  @@map("file_asset")
  documentExports PersonalDocumentExport[]
}

// G19: workspace-owned knowledge source content. aij-ai is the sole data owner;
// ClientWorkspace remains the tenant boundary and its membership owns access.
model AiKnowledgeDocument {
sourceUrl               String? @map("source_url") @db.VarChar(2048)
sourceFinalUrl          String? @map("source_final_url") @db.VarChar(2048)
sourceTextChecksum      String? @map("source_text_checksum") @db.Char(64)
sourceExtractionVersion String? @map("source_extraction_version") @db.VarChar(64)
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  documentCode      String    @map("document_code")
  sourceFilename    String?   @map("source_filename")
  sourceChecksum    String?   @map("source_checksum") @db.Char(64)
  title             String
  content           String    @db.Text
  status            String    @default("active")
  createdByMemberId String    @map("created_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  workspace ClientWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    MemberUser      @relation("AiKnowledgeDocumentAuthor", fields: [createdByMemberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, documentCode], map: "ai_knowledge_document_workspace_code_key")
  @@index([workspaceId, status, deletedAt], map: "ai_knowledge_document_workspace_status_idx")
  @@index([workspaceId, createdAt], map: "ai_knowledge_document_workspace_created_idx")
  @@map("ai_knowledge_document")
}

// AF-110: aij-ai owns customer question/result state; workspace auth, AsyncRuntime and trace/cost remain separate owners.
model AiKnowledgeQuestion {
  id                 String                    @id @default(cuid())
  workspaceId        String                    @map("workspace_id")
  memberId           String                    @map("member_id")
  idempotencyKeyHash String                    @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint String                    @map("request_fingerprint") @db.Char(64)
  query              String                    @db.Text
  status             AiKnowledgeQuestionStatus @default(queued)
  answer             String?                   @db.Text
  citations          Json?
  refusalCode        String?                   @map("refusal_code")
  failureCode        String?                   @map("failure_code")
  runtimeJobId       String?                   @unique @map("runtime_job_id")
  traceId            String?                   @map("trace_id")
  contentPurgedAt    DateTime?                 @map("content_purged_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  workspace  ClientWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  member     MemberUser      @relation("AiKnowledgeQuestionMember", fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  runtimeJob RuntimeJob?     @relation(fields: [runtimeJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  evaluations AiEvaluationRecord[]
  @@unique([id, workspaceId], map: "ai_knowledge_question_id_workspace_key")
  @@unique([workspaceId, idempotencyKeyHash], map: "ai_knowledge_question_workspace_idempotency_key")
  @@index([workspaceId, status, createdAt], map: "ai_knowledge_question_workspace_status_created_idx")
  @@index([createdAt], map: "ai_knowledge_question_created_at_idx")
  @@map("ai_knowledge_question")
}

