// AF-006: directed extraction from qingqi-ai-consultant, dev@cd8d006ffd3f2830dd0bdb4e62d0288e059dd9eb.
// Source hash and license limits: docs/governance/SOURCE_PROVENANCE.md, section 6.
// AF-006: seven core models and two enums; no business reverse relations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum ResourceType {
  menu
  button
  api
  data
}

enum PaymentOrderStatus {
  created
  pending
  succeeded
  failed
  closed
}

enum PaymentAttemptStatus {
  created
  submitting
  pending
  succeeded
  failed
  unknown
  cancelled
}

enum PaymentCallbackEventStatus {
  received
  accepted
  rejected
}

enum PaymentTransactionKind {
  charge
  refund
  reversal
}

enum PaymentRefundRequestStatus {
  pending_manual_review
}

enum PaymentReconciliationDiscrepancyType {
  missing_local
  missing_provider
  duplicate_provider
  order_mismatch
  amount_mismatch
  currency_mismatch
  status_mismatch
}

enum PaymentReconciliationReviewState {
  open
  acknowledged
  escalated
}

model SysUser {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String        @map("password_hash")
  realName     String        @map("real_name")
  phone        String?
  email        String?
  status       UserStatus    @default(active)
  isSuperAdmin Boolean       @default(false) @map("is_super_admin")
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  userRoles    SysUserRole[]
  tokenVersion Int           @default(0) @map("token_version")
  sessions     AdminAuthSession[]
  paymentRefundRequests PaymentRefundRequest[]
  paymentReconciliationRuns PaymentReconciliationRun[]
  paymentReconciliationReviews PaymentReconciliationDiscrepancy[] @relation("PaymentReconciliationReviewer")

  @@map("sys_user")
}

// AF-026 / UI1-01: core admin identity owner; distinct from client sessions.
// Store session metadata only, never bearer tokens or credentials.
model AdminAuthSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  namespace    String
  transport    String   @default("bearer")
  issuedAt     DateTime @default(now()) @map("issued_at")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?  @map("revoke_reason")
  user         SysUser  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, namespace, revokedAt])
  @@index([expiresAt])
  @@map("admin_auth_session")
}

model SysRole {
  id          String              @id @default(cuid())
  roleCode    String              @unique @map("role_code")
  roleName    String              @map("role_name")
  dataScope   String              @default("all") @map("data_scope")
  status      String              @default("active")
  remark      String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")
  userRoles   SysUserRole[]
  permissions SysRolePermission[]
  menus       SysRoleMenu[]

  @@map("sys_role")
}

model SysPermission {
  id             String              @id @default(cuid())
  permissionCode String              @unique @map("permission_code")
  permissionName String              @map("permission_name")
  resourceType   ResourceType        @map("resource_type")
  module         String
  action         String
  apiPath        String?             @map("api_path")
  status         String              @default("active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  roles          SysRolePermission[]

  @@map("sys_permission")
}

model SysMenu {
  id             String        @id @default(cuid())
  parentId       String?       @map("parent_id")
  title          String
  path           String        @unique
  icon           String?
  type           String        @default("menu")
  permissionCode String?       @map("permission_code")
  pluginCode     String?       @map("plugin_code")
  sortOrder      Int           @default(0) @map("sort_order")
  visible        Boolean       @default(true)
  status         String        @default("active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  roles          SysRoleMenu[]

  @@index([parentId])
  @@index([status])
  @@map("sys_menu")
}

// Mandatory relations retain Prisma 6's source defaults, now stated explicitly.
// Remove join rows deliberately before hard-deleting a referenced core record.
model SysUserRole {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  roleId String  @map("role_id")
  user   SysUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role   SysRole @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@map("sys_user_role")
}

model SysRolePermission {
  id           String        @id @default(cuid())
  roleId       String        @map("role_id")
  permissionId String        @map("permission_id")
  role         SysRole       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   SysPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@map("sys_role_permission")
}

model SysRoleMenu {
  id     String  @id @default(cuid())
  roleId String  @map("role_id")
  menuId String  @map("menu_id")
  role   SysRole @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  menu   SysMenu @relation(fields: [menuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, menuId])
  @@map("sys_role_menu")
}

// AF-007: five AIJ identity models from the same verified source; provenance section 7.
model MemberUser {
  personalAiSkills        AiPersonalSkill[]
  personalAiSkillVersions AiPersonalSkillVersion[]
  id                String    @id @default(cuid())
  username          String?   @unique
  mobile            String?   @unique
  email             String?   @unique
  nickname          String
  avatar            String?
  passwordHash      String?   @map("password_hash")
  tokenVersion      Int       @default(0) @map("token_version")
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  status            String    @default("active")
  remark            String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  authSessions   ClientAuthSession[]
  authTokens     ClientAuthOneTimeToken[]
  consentRecords ClientConsentRecord[]
  createdWorkspaces ClientWorkspace[] @relation("ClientWorkspaceCreator")
  workspaceMemberships ClientWorkspaceMembership[]
  authoredAiKnowledgeDocuments AiKnowledgeDocument[] @relation("AiKnowledgeDocumentAuthor")
  aiKnowledgeQuestions AiKnowledgeQuestion[] @relation("AiKnowledgeQuestionMember")
  aiAgentRuns AiAgentRun[]

  @@index([status])
  @@map("member_user")
  personalAiAgents AiPersonalAgent[]
  personalAiAgentVersions AiPersonalAgentVersion[]
  personalAiMemories AiPersonalMemory[]
  personalWorkflows AiPersonalWorkflow[]
}

model ClientAuthSession {
  personalScriptRuns AiPersonalScriptRun[]
  id            String    @id @default(cuid())
  memberId      String    @map("member_id")
  namespace     String
  status        String    @default("active")
  deviceHash    String    @map("device_hash")
  deviceSummary String    @map("device_summary")
  ipHash        String    @map("ip_hash")
  regionSummary String?   @map("region_summary")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?   @map("revoke_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  member MemberUser @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([namespace, memberId, status, lastSeenAt], map: "client_auth_session_namespace_member_status_seen_idx")
  @@index([expiresAt], map: "client_auth_session_expires_idx")
  @@unique([id,memberId], map: "client_session_origin_member_uq")
  @@map("client_auth_session")
}

model ClientAuthOneTimeToken {
  id         String    @id @default(cuid())
  memberId   String    @map("member_id")
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  member MemberUser @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([memberId, purpose, createdAt], map: "client_auth_token_member_purpose_created_idx")
  @@index([purpose, expiresAt], map: "client_auth_token_purpose_expires_idx")
  @@map("client_auth_one_time_token")
}

model ClientConsentRecord {
  id          String    @id @default(cuid())
  memberId    String    @map("member_id")
  namespace   String
  consentType String    @map("consent_type")
  granted     Boolean
  textVersion String    @map("text_version")
  textDigest  String    @map("text_digest")
  source      String
  capturedAt  DateTime  @default(now()) @map("captured_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  member MemberUser @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([namespace, memberId, consentType, capturedAt], map: "client_consent_namespace_member_type_captured_idx")
  @@map("client_consent_record")
}

model ClientAuthRateBucket {
  id              String    @id @default(cuid())
  scope           String
  keyHash         String    @map("key_hash")
  attemptCount    Int       @default(0) @map("attempt_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  lastAttemptAt   DateTime  @default(now()) @map("last_attempt_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([scope, keyHash])
  @@index([scope, blockedUntil])
  @@index([windowStartedAt])
  @@map("client_auth_rate_bucket")
}

// AF-053 / NEXT-06: customer tenancy is separate from ProjectProfile and SysRole.
// Invitations and business/product relations are intentionally outside this base schema.
model ClientWorkspace {
  personalAiSkills        AiPersonalSkill[]
  personalAiSkillVersions AiPersonalSkillVersion[]
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  status                 String    @default("active")
  timezone               String    @default("Asia/Shanghai")
  locale                 String    @default("zh-CN")
  createdByMemberId      String    @map("created_by_member_id")
  creationIdempotencyKey String    @map("creation_idempotency_key")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  createdBy    MemberUser                 @relation("ClientWorkspaceCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles        ClientWorkspaceRole[]
  memberships  ClientWorkspaceMembership[]
  aiAgentRuns AiAgentRun[]
  aiKnowledgeDocuments AiKnowledgeDocument[]
  aiKnowledgeQuestions AiKnowledgeQuestion[]

  @@unique([createdByMemberId, creationIdempotencyKey], map: "client_workspace_creator_idempotency_key")
  @@index([status, deletedAt], map: "client_workspace_status_deleted_idx")
  @@map("client_workspace")
  personalAiAgents AiPersonalAgent[]
  personalAiAgentVersions AiPersonalAgentVersion[]
  personalAiMemories AiPersonalMemory[]
  personalWorkflows AiPersonalWorkflow[]
}

model ClientWorkspaceRole {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  code        String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  status      String    @default("active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace       ClientWorkspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships     ClientWorkspaceMembership[]
  rolePermissions ClientWorkspaceRolePermission[]

  @@unique([workspaceId, code], map: "client_workspace_role_workspace_code_key")
  @@unique([workspaceId, id], map: "client_workspace_role_workspace_id_key")
  @@index([workspaceId, status, sortOrder], map: "client_workspace_role_scope_status_sort_idx")
  @@map("client_workspace_role")
}

model ClientWorkspacePermission {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions ClientWorkspaceRolePermission[]

  @@index([status], map: "client_workspace_permission_status_idx")
  @@map("client_workspace_permission")
}

model ClientWorkspaceRolePermission {
  id           String    @id @default(cuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role       ClientWorkspaceRole       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission ClientWorkspacePermission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId], map: "client_workspace_role_permission_key")
  @@index([permissionId], map: "client_workspace_role_permission_permission_idx")
  @@map("client_workspace_role_permission")
}

model ClientWorkspaceMembership {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  memberId       String    @map("member_id")
  roleId         String    @map("role_id")
  status         String    @default("active")
  sessionVersion Int       @default(0) @map("session_version")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  disabledAt     DateTime? @map("disabled_at")
  removedAt      DateTime? @map("removed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace ClientWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  member    MemberUser          @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      ClientWorkspaceRole @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Cascade)
  paymentOrders PaymentOrder[]
  personalDocuments PersonalDocument[]

  @@unique([workspaceId, memberId], map: "client_workspace_membership_workspace_member_key")
  @@index([memberId, status, createdAt], map: "client_workspace_membership_member_status_idx")
  @@index([workspaceId, roleId, status], map: "client_workspace_membership_role_status_idx")
  @@map("client_workspace_membership")
}

// AF-008: configuration, reference and audit definitions; provenance section 8.
model OrganizationProfile {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  legalEntity String?   @map("legal_entity")
  status      String    @default("active")
  meta        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  projects ProjectProfile[]

  @@index([status])
  @@map("organization_profile")
}

model ProjectProfile {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  code           String    @unique
  name           String
  legalEntity    String?   @map("legal_entity")
  timezone       String    @default("Asia/Shanghai")
  currency       String    @default("CNY")
  locale         String    @default("zh-CN")
  brand          Json?
  environment    String    @default("development")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aiExecutionTraces AiExecutionTrace[]
  connectorInstallations ConnectorInstallation[]
  paymentOrders PaymentOrder[]
  paymentCallbackEvents PaymentCallbackEvent[]
  paymentRefundRequests PaymentRefundRequest[]
  paymentReconciliationRuns PaymentReconciliationRun[]
  paymentReconciliationDiscrepancies PaymentReconciliationDiscrepancy[]

  @@index([organizationId, status])
  @@map("project_profile")
  documentExports PersonalDocumentExport[]
  personalScriptVersions AiPersonalScriptVersion[]
}

// G18-02 / AF-104: payment ledger owns request/attempt state; payable ownership remains external.
model PaymentOrder {
  id                    String             @id @default(cuid())
  projectId             String             @map("project_id")
  workspaceId           String             @map("workspace_id")
  memberId              String             @map("member_id")
  orderNo               String             @unique @map("order_no")
  payableOwner          String             @map("payable_owner")
  payableReference      String             @map("payable_reference")
  amountMinor           BigInt             @map("amount_minor")
  currency              String             @db.Char(3)
  currencyExponent      Int                @map("currency_exponent")
  idempotencyKeyHash    String             @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint    String             @map("request_fingerprint") @db.Char(64)
  status                PaymentOrderStatus @default(created)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")

  project    ProjectProfile            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership ClientWorkspaceMembership @relation(fields: [workspaceId, memberId], references: [workspaceId, memberId], onDelete: Restrict, onUpdate: Cascade)
  attempts   PaymentAttempt[]
  callbackEvents PaymentCallbackEvent[]
  transactions PaymentTransaction[]
  refundRequests PaymentRefundRequest[]
  reconciliationDiscrepancies PaymentReconciliationDiscrepancy[]

  @@unique([projectId, workspaceId, memberId, idempotencyKeyHash], map: "payment_order_scope_idempotency_key")
  @@unique([id, projectId], map: "payment_order_id_project_key")
  @@index([projectId, workspaceId, memberId, createdAt], map: "payment_order_member_scope_created_idx")
  @@index([status, createdAt], map: "payment_order_status_created_idx")
  @@map("payment_order")
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  orderId           String               @map("order_id")
  attemptNumber     Int                  @map("attempt_number")
  providerCode      String               @map("provider_code")
  providerReference String?              @map("provider_reference")
  credentialRef     String?              @map("credential_ref")
  status            PaymentAttemptStatus @default(created)
  submittedAt       DateTime?            @map("submitted_at")
  observedAt        DateTime?            @map("observed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  callbackEvents PaymentCallbackEvent[]
  transactions PaymentTransaction[]

  @@unique([orderId, attemptNumber], map: "payment_attempt_order_number_key")
  @@unique([providerCode, providerReference], map: "payment_attempt_provider_reference_key")
  @@index([status, createdAt], map: "payment_attempt_status_created_idx")
  @@map("payment_attempt")
}

// G18-03: aij-payment owns authenticated callback replay receipts and immutable transaction facts.
model PaymentCallbackEvent {
  id             String                      @id @default(cuid())
  projectId      String                      @map("project_id")
  orderId        String                      @map("order_id")
  attemptId      String                      @map("attempt_id")
  providerCode   String                      @map("provider_code")
  eventId        String                      @map("event_id")
  payloadSha256  String                      @map("payload_sha256") @db.Char(64)
  status         PaymentCallbackEventStatus  @default(received)
  failureCode    String?                     @map("failure_code")
  receivedAt     DateTime                    @default(now()) @map("received_at")
  processedAt    DateTime?                   @map("processed_at")

  project     ProjectProfile @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order       PaymentOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempt     PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transaction PaymentTransaction?

  @@unique([projectId, providerCode, eventId], map: "payment_callback_project_provider_event_key")
  @@index([orderId, receivedAt], map: "payment_callback_order_received_idx")
  @@map("payment_callback_event")
}

model PaymentTransaction {
  id                    String                 @id @default(cuid())
  orderId               String                 @map("order_id")
  attemptId             String                 @map("attempt_id")
  callbackEventId       String                 @unique(map: "payment_transaction_callback_event_key") @map("callback_event_id")
  providerCode          String                 @map("provider_code")
  providerReference     String                 @map("provider_reference")
  kind                  PaymentTransactionKind
  amountMinor           BigInt                 @map("amount_minor")
  currency              String                 @db.Char(3)
  occurredAt            DateTime               @map("occurred_at")
  recordedAt            DateTime               @default(now()) @map("recorded_at")

  order         PaymentOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempt       PaymentAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  callbackEvent PaymentCallbackEvent @relation(fields: [callbackEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refundRequests PaymentRefundRequest[]
  reconciliationDiscrepancies PaymentReconciliationDiscrepancy[]

  @@unique([providerCode, providerReference, kind], map: "payment_transaction_provider_reference_kind_key")
  @@unique([id, orderId], map: "payment_transaction_id_order_key")
  @@index([orderId, recordedAt], map: "payment_transaction_order_recorded_idx")
  @@map("payment_transaction")
}

// G18-04 / AF-106: a refund request is a manual-review record only; it is never a provider command.
model PaymentRefundRequest {
  id                    String                       @id @default(cuid())
  projectId             String                       @map("project_id")
  paymentOrderId        String                       @map("payment_order_id")
  chargeTransactionId   String                       @map("charge_transaction_id")
  requestedByUserId     String                       @map("requested_by_user_id")
  amountMinor           BigInt                       @map("amount_minor")
  currency              String                       @db.Char(3)
  currencyExponent      Int                          @map("currency_exponent")
  reason                String                       @db.VarChar(500)
  idempotencyKeyHash    String                       @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint    String                       @map("request_fingerprint") @db.Char(64)
  status                PaymentRefundRequestStatus   @default(pending_manual_review)
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  project           ProjectProfile     @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentOrder      PaymentOrder       @relation(fields: [paymentOrderId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  chargeTransaction PaymentTransaction @relation(fields: [chargeTransactionId, paymentOrderId], references: [id, orderId], onDelete: Restrict, onUpdate: Cascade)
  requestedBy       SysUser            @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, requestedByUserId, idempotencyKeyHash], map: "payment_refund_request_scope_idempotency_key")
  @@index([paymentOrderId, status, createdAt], map: "payment_refund_request_order_status_created_idx")
  @@index([projectId, createdAt], map: "payment_refund_request_project_created_idx")
  @@map("payment_refund_request")
}

// G18-05 / AF-107: normalized reconciliation evidence and operator disposition only.
// This owner never writes PaymentOrder, PaymentAttempt or PaymentTransaction facts.
model PaymentReconciliationRun {
  id                    String   @id @default(cuid())
  projectId             String   @map("project_id")
  providerCode          String   @map("provider_code") @db.VarChar(50)
  windowStart           DateTime @map("window_start")
  windowEnd             DateTime @map("window_end")
  sourceRecordCount     Int      @map("source_record_count")
  matchedCount          Int      @map("matched_count")
  discrepancyCount      Int      @map("discrepancy_count")
  idempotencyKeyHash    String   @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint    String   @map("request_fingerprint") @db.Char(64)
  createdByUserId       String   @map("created_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")

  project    ProjectProfile @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy  SysUser        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items      PaymentReconciliationDiscrepancy[]

  @@unique([id, projectId], map: "payment_reconciliation_run_id_project_key")
  @@unique([projectId, createdByUserId, idempotencyKeyHash], map: "payment_reconciliation_run_scope_idempotency_key")
  @@index([projectId, createdAt], map: "payment_reconciliation_run_project_created_idx")
  @@index([projectId, providerCode, windowStart, windowEnd], map: "payment_reconciliation_run_provider_window_idx")
  @@map("payment_reconciliation_run")
}

model PaymentReconciliationDiscrepancy {
  id                    String                              @id @default(cuid())
  projectId             String                              @map("project_id")
  runId                 String                              @map("run_id")
  sequence              Int
  type                  PaymentReconciliationDiscrepancyType
  reviewState           PaymentReconciliationReviewState    @default(open) @map("review_state")
  orderId               String?                             @map("order_id")
  transactionId         String?                             @map("transaction_id")
  observedOrderNo       String?                             @map("observed_order_no") @db.VarChar(100)
  providerReferenceHash String?                             @map("provider_reference_hash") @db.Char(64)
  sourceRecordHash      String                              @map("source_record_hash") @db.Char(64)
  localAmountMinor      BigInt?                             @map("local_amount_minor")
  observedAmountMinor   BigInt?                             @map("observed_amount_minor")
  localCurrency         String?                             @map("local_currency") @db.Char(3)
  observedCurrency      String?                             @map("observed_currency") @db.Char(3)
  localStatus           String?                             @map("local_status") @db.VarChar(32)
  observedStatus        String?                             @map("observed_status") @db.VarChar(32)
  observedAt            DateTime?                           @map("observed_at")
  reviewedByUserId      String?                             @map("reviewed_by_user_id")
  reviewedAt            DateTime?                           @map("reviewed_at")
  createdAt             DateTime                            @default(now()) @map("created_at")

  project     ProjectProfile          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  run         PaymentReconciliationRun @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  order       PaymentOrder?           @relation(fields: [orderId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  transaction PaymentTransaction?     @relation(fields: [transactionId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  SysUser?                @relation("PaymentReconciliationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([runId, sequence], map: "payment_reconciliation_discrepancy_run_sequence_key")
  @@index([projectId, reviewState, createdAt], map: "payment_reconciliation_discrepancy_project_review_idx")
  @@index([runId, type, reviewState], map: "payment_reconciliation_discrepancy_run_type_idx")
  @@map("payment_reconciliation_discrepancy")
}

model ScopedConfig {
  id          String    @id @default(cuid())
  scope       String
  scopeId     String    @map("scope_id")
  pluginCode  String    @default("") @map("plugin_code")
  configKey   String    @map("config_key")
  configValue String    @map("config_value")
  valueType   String    @default("string") @map("value_type")
  name        String
  description String?
  sensitive   Boolean   @default(false)
  isPublic    Boolean   @default(false) @map("is_public")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // AF-008: revision metadata only; atomic version checks belong to the future service.
  version Int                   @default(1)
  changes ConfigurationChange[]

  @@unique([scope, scopeId, pluginCode, configKey])
  @@index([scope, scopeId, status])
  @@index([pluginCode, configKey])
  @@map("scoped_config")
}

model ConfigurationChange {
  id             String    @id @default(cuid())
  eventType      String    @default("configuration.changed") @map("event_type")
  scope          String
  scopeId        String    @map("scope_id")
  pluginCode     String    @default("") @map("plugin_code")
  configKey      String    @map("config_key")
  operatorId     String?   @map("operator_id")
  operatorName   String?   @map("operator_name")
  changeMetadata Json?     @map("change_metadata")
  status         String    @default("recorded")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Optional for non-scoped events such as project metadata or reference changes.
  // Captured version is historical, not an FK to the mutable current version.
  configId      String?       @map("config_id")
  configVersion Int?          @map("config_version")
  auditLogId    String?       @map("audit_log_id")
  config        ScopedConfig? @relation(fields: [configId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLog      AuditLog?     @relation(fields: [auditLogId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([configId, configVersion])
  @@index([auditLogId])
  @@index([scope, scopeId, createdAt])
  @@index([configKey])
  @@map("configuration_change")
}

model SecretReference {
  id              String    @id @default(cuid())
