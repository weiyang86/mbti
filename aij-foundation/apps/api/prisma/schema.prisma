// Adapted from source Plugin, not a copy of its business module registry.
// Version is the requested/last-known version, including an uninstalled row.
// Owner is the implementation package/module identifier, never authorization.
model PluginInstallation {
  id            String                   @id @default(cuid())
  projectId     String                   @map("project_id")
  pluginCode    String                   @map("plugin_code")
  version       String
  owner         String
  status        PluginInstallationStatus @default(uninstalled)
  installedAt   DateTime?                @map("installed_at")
  enabledAt     DateTime?                @map("enabled_at")
  disabledAt    DateTime?                @map("disabled_at")
  uninstalledAt DateTime?                @map("uninstalled_at")
  failureReason String?                  @map("failure_reason")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  operations PluginOperation[]

  @@unique([projectId, pluginCode])
  @@index([status])
  @@map("plugin_installation")
}

// Adapted from PluginInstallLog; version/owner are historical snapshots.
// Action remains a required string; its allowlist and transitions are future service rules.
model PluginOperation {
  id             String                @id @default(cuid())
  installationId String                @map("installation_id")
  action         String
  version        String
  previousVersion String?               @map("previous_version")
  owner          String
  status         PluginOperationStatus @default(pending)
  failureReason  String?               @map("failure_reason")
  operatorId     String?               @map("operator_id")
  retryOfOperationId String?           @unique(map: "plugin_operation_retry_of_key") @map("retry_of_operation_id")
  startedAt      DateTime?             @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  installation PluginInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  retryOfOperation PluginOperation? @relation("PluginOperationRetry", fields: [retryOfOperationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  retryAttempt PluginOperation? @relation("PluginOperationRetry")

  @@index([installationId, createdAt])
  @@index([status, createdAt])
  @@map("plugin_operation")
}

// AF-021: F00 SysDict/SysDictItem core slice; no source records or business relations.
model SysDict {
  id          String    @id @default(cuid())
  dictCode    String    @unique @map("dict_code")
  dictName    String    @map("dict_name")
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Reserved for future plugin-owned registration; admin DTO cannot set/adopt this owner.
  pluginCode String? @map("plugin_code")
  isPublic Boolean @default(false) @map("is_public")
  items SysDictItem[]

  @@index([status])
  @@map("system_dict")
}

model SysDictItem {
  id          String    @id @default(cuid())
  dictId      String    @map("dict_id")
  itemLabel   String    @map("item_label")
  itemValue   String    @map("item_value")
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  dict SysDict @relation(fields: [dictId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([dictId, itemValue])
  @@index([dictId])
  @@index([status])
  @@map("system_dict_item")
}

// AF-049: durable generic runtime queue owner. No business-specific relations or payload logging.
model RuntimeOutbox {
  id             String              @id @default(uuid())
  eventType      String              @map("event_type")
  eventVersion   Int                 @default(1) @map("event_version")
  occurredAt     DateTime            @map("occurred_at")
  producer       String
  scope          Json
  correlationId  String?             @map("correlation_id")
  causationId    String?             @map("causation_id")
  idempotencyKey String              @map("idempotency_key")
  payload        Json
  status         RuntimeOutboxStatus @default(pending)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(8) @map("max_attempts")
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at")
  processedAt    DateTime?           @map("processed_at")
  lastError      String?             @map("last_error")
  leaseOwner     String?             @map("lease_owner")
  leaseExpiresAt DateTime?           @map("lease_expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  @@unique([eventType, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@map("runtime_outbox")
}

// AF-049: generic scheduled/background work. Business handlers register against this contract.
model RuntimeJob {
  personalScriptRun AiPersonalScriptRun?
  leaseNonce String? @map("lease_nonce") @db.Uuid
  id              String          @id @default(cuid())
  jobType         String          @map("job_type")
  jobVersion      Int             @default(1) @map("job_version")
  payload         Json
  scope           String
  scopeId         String          @map("scope_id")
  pluginCode      String          @default("") @map("plugin_code")
  workspaceId     String?         @map("workspace_id")
  status          RuntimeJobStatus @default(pending)
  priority        Int             @default(0)
  runAt           DateTime        @default(now()) @map("run_at")
  attempts        Int             @default(0)
  maxAttempts     Int             @default(5) @map("max_attempts")
  timeoutMs       Int             @default(30000) @map("timeout_ms")
  dedupeKey       String?         @map("dedupe_key")
  idempotencyKey  String          @map("idempotency_key")
  correlationId   String?         @map("correlation_id")
  resultReference Json?           @map("result_reference")
  lastError       String?         @map("last_error")
  leaseOwner      String?         @map("lease_owner")
  leaseExpiresAt  DateTime?       @map("lease_expires_at")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  aiExecutionTraces AiExecutionTrace[]
  aiKnowledgeQuestion AiKnowledgeQuestion?
  aiAgentRun AiAgentRun?

  @@unique([scope, scopeId, jobType, dedupeKey])
  @@unique([scope, scopeId, jobType, idempotencyKey])
  @@index([status, runAt, priority])
  @@index([leaseExpiresAt])
  @@index([workspaceId, status, runAt], map: "runtime_job_workspace_status_run_idx")
  @@unique([id, scopeId, workspaceId], map: "runtime_job_script_scope_key")
  @@map("runtime_job")
}

// G15-03: one AI-owned trace/cost truth row per durable runtime-job attempt.
// Content is stored only as a value-free shape projection; cost is provider-reported or absent.
model AiExecutionTrace {
  id                 String                       @id @default(uuid())
  jobId              String                       @map("job_id")
  attempt            Int
  projectId          String                       @map("project_id")
  correlationId      String                       @map("correlation_id")
  capabilityCode     String                       @map("capability_code")
  providerCode       String?                      @map("provider_code")
